# AI Automation HQ 환경 변수 목록(설명만, 값 없음)
# 비밀 값은 Cloudflare Secret(wrangler secret put) 또는 로컬 .dev.vars 에만 둔다. 이 파일에 실제 값을 넣지 않는다.

# ---- wrangler.jsonc vars (비밀 아님) ----
# APP_MODE=live                 # live | demo (demo는 로컬 전용 샘플 모드)
# APP_TIMEZONE=Asia/Seoul
# PUBLIC_BASE_URL=              # 예: https://automatehq.<계정>.workers.dev — 카카오 Redirect URI·보고서 링크
# ALLOWED_ORIGINS=              # 쉼표 구분 추가 허용 Origin(보통 비움)

# ---- Cloudflare secrets ----
# ADMIN_PASSWORD_HASH=          # npm run secret:password
# HQ_ENCRYPTION_KEY=            # npm run secret:keygen
# HQ_ENCRYPTION_KEY_PREVIOUS=   # 키 교체 기간에만
# GITHUB_WEBHOOK_SECRET=
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=

# ---- 자동화 프로그램 쪽(HQ가 아니라 각 프로젝트 저장소의 secret) ----
# HQ_URL=
# HQ_PROJECT_KEY=
# HQ_HEARTBEAT_SECRET=
