{
  "name": "ai-automation-hq",
  "version": "0.1.0",
  "private": true,
  "description": "AI Automation HQ — 여러 GitHub 저장소와 자동화 작업을 감시·운영하고 매일 07:00 KST 카카오톡 보고서를 보내는 개인용 관제 시스템",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs live",
    "dev:demo": "node scripts/dev.mjs demo",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:worker:demo": "wrangler dev --env demo --port 8787",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply automatehq --local",
    "db:migrate:remote": "wrangler d1 migrations apply automatehq --remote",
    "demo:reset": "node scripts/demo-reset.mjs",
    "secret:password": "node scripts/hash-password.mjs",
    "secret:keygen": "node scripts/gen-key.mjs",
    "heartbeat:sign": "node scripts/heartbeat-send.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply automatehq --remote && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
