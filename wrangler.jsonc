// AI Automation HQ — Cloudflare Worker 설정
// - Cron Trigger는 UTC 기준이다. 10분마다 한 번 깨어나 내부 작업(동기화·판정·08:00 KST 보고서)을 처리한다.
//   무료 플랜은 계정당 Cron Trigger 5개 제한이 있어 표현식 1개만 쓴다.
// - 비밀 값(ADMIN_PASSWORD_HASH, HQ_ENCRYPTION_KEY, GITHUB_WEBHOOK_SECRET, KAKAO_REST_API_KEY, KAKAO_CLIENT_SECRET)은
//   `wrangler secret put` 으로만 넣는다. 이 파일에 적지 않는다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automatehq",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 이 계정은 무료 플랜 Cron 5개를 다른 Worker가 모두 사용 중이라 Cloudflare Cron을 등록하지 않는다.
  // 대신 .github/workflows/scheduler.yml(10분 간격)이 POST /api/v1/scheduler/tick 을 OIDC 서명으로 호출한다.
  // Cron 슬롯이 비면 ["*/10 * * * *"] 로 바꿔 Cloudflare Cron을 쓰면 된다(scheduled 핸들러는 그대로 있음).
  "triggers": { "crons": [] },
  "vars": {
    "APP_MODE": "live",
    "APP_TIMEZONE": "Asia/Seoul",
    "PUBLIC_BASE_URL": "https://automatehq.dlacoaud96.workers.dev",
    "ALLOWED_ORIGINS": "",
    "SCHEDULER_OIDC_REPOSITORY": "Logic-Phantom/AutoMateHQ"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "automatehq",
      "database_id": "a00e5b07-49d9-419a-8fc5-96fddd02d2d1",
      "migrations_dir": "worker/migrations"
    }
  ],
  "env": {
    // 샘플 데이터 전용 환경. 로컬에서만 쓰며 실제 운영 DB와 물리적으로 분리된 별도 D1을 쓴다.
    "demo": {
      "name": "automatehq-demo",
      "triggers": { "crons": [] },
      "vars": {
        "APP_MODE": "demo",
        "APP_TIMEZONE": "Asia/Seoul",
        "PUBLIC_BASE_URL": "http://localhost:5173",
        "ALLOWED_ORIGINS": "http://localhost:5173",
        // 샘플 모드에서는 외부 스케줄러 트리거를 쓰지 않는다(빈 값 = /api/v1/scheduler/tick 비활성)
        "SCHEDULER_OIDC_REPOSITORY": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "automatehq-demo",
          "database_id": "00000000-0000-0000-0000-00000000de00",
          "migrations_dir": "worker/migrations"
        }
      ]
    }
  }
}
